# MedSummarize Backend Environment Variables

# Application Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./medsummarize.db
MONGODB_URL=mongodb://localhost:27017/medsummarize
REDIS_URL=redis://localhost:6379

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=medsummarize

# AI/ML API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-west-2
S3_BUCKET_NAME=medsummarize-uploads

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=uploads

# OCR Settings
TESSERACT_CMD=/usr/bin/tesseract  # Adjust for your system

# spaCy Model
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/medsummarize.log