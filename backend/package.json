{
  "name": "medsummarize-backend",
  "version": "1.0.0",
  "description": "AI-powered medical report summarization backend API",
  "main": "main.py",
  "scripts": {
    "start": "uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "production": "gunicorn main:app -w 4 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000",
    "test": "pytest",
    "lint": "flake8 .",
    "format": "black .",
    "db-init": "python -c \"from database.database import init_db; init_db()\"",
    "db-reset": "python -c \"from database.database import drop_db, init_db; drop_db(); init_db()\""
  },
  "dependencies": {
    "fastapi": "^0.104.1",
    "uvicorn[standard]": "^0.24.0",
    "python-multipart": "^0.0.6",
    "pydantic": "^2.5.0",
    "pydantic-settings": "^2.1.0",
    "sqlalchemy": "^2.0.23",
    "alembic": "^1.13.1",
    "python-jose[cryptography]": "^3.3.0",
    "passlib[bcrypt]": "^1.7.4",
    "python-dotenv": "^1.0.0",
    "aiofiles": "^23.2.1",
    "httpx": "^0.25.2",
    "openai": "^1.3.7",
    "google-generativeai": "^0.3.2",
    "transformers": "^4.36.0",
    "torch": "^2.1.1",
    "spacy": "^3.7.2",
    "presidio-analyzer": "^2.2.33",
    "presidio-anonymizer": "^2.2.33",
    "pytesseract": "^0.3.10",
    "Pillow": "^10.1.0",
    "opencv-python": "^4.8.1.78",
    "pymongo": "^4.6.0",
    "pinecone-client": "^2.2.4",
    "redis": "^5.0.1",
    "loguru": "^0.7.2",
    "sentry-sdk": "^1.38.0"
  },
  "devDependencies": {
    "pytest": "^7.4.3",
    "pytest-asyncio": "^0.21.1",
    "black": "^23.11.0",
    "flake8": "^6.1.0",
    "mypy": "^1.7.1"
  },
  "keywords": [
    "medical",
    "ai",
    "nlp",
    "ocr",
    "hipaa",
    "summarization",
    "healthcare"
  ],
  "author": "MedSummarize Team",
  "license": "MIT"
}